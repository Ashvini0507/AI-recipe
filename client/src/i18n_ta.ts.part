            "recipes": {
                "rec-1": { "title": "பாலக் பன்னீர்", "instructions": ["கீரையை 2 நிமிடம் வேக வைக்கவும்", "இஞ்சி, பூண்டுடன் அரைக்கவும்", "வெங்காயம் மற்றும் மசாலாக்களை வதக்கவும்", "கீரை விழுதைச் சேர்த்து கொதிக்க விடவும்", "பன்னீர் துண்டுகளைச் சேர்க்கவும்", "சூடாகப் பரிமாறவும்"] },
                "rec-2": { "title": "கிரில் சிக்கன்", "instructions": ["தயிர் மற்றும் மசாலாக்களுடன் இஞ்சியை ஊற வைக்கவும்", "15-20 நிமிடம் கிரில் செய்யவும்", "சாலட்டுடன் பரிமாறவும்"] },
                "rec-3": { "title": "கிரீமி பாஸ்தா", "instructions": ["பாஸ்தாவை வேக வைக்கவும்", "பாலுடன் சீஸ் சாஸ் தயார் செய்யவும்", "பாஸ்தாவை சாஸுடன் கலக்கவும்", "அலங்கரித்துப் பரிமாறவும்"] },
                "rec-4": { "title": "பிரெஷ் சாலட்", "instructions": ["காய்கறிகளை நறுக்கவும்", "எலுமிச்சை சாறுடன் கலக்கவும்", "உப்பு சேர்த்துப் பரிமாறவும்"] },
                "rec-5": { "title": "சிக்கன் பிரியாணி", "instructions": ["சிக்கனை ஊற வைக்கவும்", "அரிசியுடன் அடுக்குகளாக வைக்கவும்", "25 நிமிடம் தம் போடவும்", "சூடாகப் பரிமாறவும்"] },
                "rec-6": { "title": "மார்கெரிட்டா பீட்சா", "instructions": ["மாவைத் தயார் செய்யவும்", "சாஸ் மற்றும் சீஸ் சேர்க்கவும்", "450°F-ல் சுட வைக்கவும்", "நறுக்கிப் பரிமாறவும்"] },
                "rec-7": { "title": "டாம் யம் சூப்", "instructions": ["மசாலாக்களை வேக வைக்கவும்", "மீன் சேர்த்துச் சமைக்கவும்", "எலுமிச்சை சேர்த்துப் பரிமாறவும்"] },
                "rec-8": { "title": "கிரில் ஸ்டீக்", "instructions": ["இறைச்சியில் மசாலா சேர்க்கவும்", "விருப்பத்திற்கேற்ப கிரில் செய்யவும்", "சிறிது நேரம் கழித்துப் பரிமாறவும்"] },
                "rec-9": { "title": "சூஷி ரோல்ஸ்", "instructions": ["அரிசியைத் தயார் செய்யவும்", "மீன் மற்றும் காய்கறிகளுடன் ரோல் செய்யவும்", "நறுக்கிப் பரிமாறவும்"] },
                "rec-10": { "title": "கிளாசிக் பர்கர்", "instructions": ["பேட்டியை கிரில் செய்யவும்", "பன்னுடன் நறுக்கிய காய்கறிகளைச் சேர்க்கவும்", "பிரெஞ்ச் பிரைஸுடன் பரிமாறவும்"] },
                "rec-11": { "title": "தால் தட்கா", "instructions": ["பருப்பை வேக வைக்கவும்", "மசாலாக்களைத் தாளிக்கவும்", "சாதத்துடன் பரிமாறவும்"] },
                "rec-12": { "title": "பன்னீர் திக்கா", "instructions": ["பன்னீரை ஊற வைக்கவும்", "குச்சியில் கோர்த்து கிரில் செய்யவும்", "சட்னியுடன் பரிமாறவும்"] },
                "rec-13": { "title": "இட்லி மற்றும் சாம்பார்", "instructions": ["இட்லியை ஆவியில் வேக வைக்கவும்", "சாம்பார் தயார் செய்யவும்", "சட்னியுடன் பரிமாறவும்"] },
                "rec-14": { "title": "பிசி பேலே பாத்", "instructions": ["அரிசி மற்றும் பருப்பை வேக வைக்கவும்", "புளி மற்றும் மசாலா சேர்க்கவும்", "நெய் சேர்த்துப் பரிமாறவும்"] },
                "rec-15": { "title": "சிக்கன் செட்டிநாடு", "instructions": ["மசாலாக்களை வறுக்கவும்", "மசாலா விழுதில் சிக்கனைச் சமைக்கவும்", "சாதத்துடன் பரிமாறவும்"] },
                "rec-16": { "title": "வெண் பொங்கல்", "instructions": ["பாசிப்பருப்பை வறுக்கவும்", "அரிசியுடன் சேர்த்து வேக வைக்கவும்", "தாளித்துப் பரிமாறவும்"] },
                "rec-17": { "title": "மொறுமொறு தோசை", "instructions": ["மாவைத் தயார் செய்யவும்", "தவையில் மெல்லியதாக ஊற்றவும்", "மொறுமொறுப்பாகச் சுடவும்"] },
                "rec-18": { "title": "ரவா உப்புமா", "instructions": ["ரவாவை வறுக்கவும்", "காய்கறிகளை வதக்கவும்", "தண்ணீர் சேர்த்துச் சமைக்கவும்"] },
                "rec-19": { "title": "மெது வடை", "instructions": ["பருப்பை அரைக்கவும்", "வடை வடிவில் எண்ணெயில் பொரிக்கவும்", "சட்னியுடன் பரிமாறவும்"] },
                "rec-20": { "title": "புட்டும் கடலைக்கறியும்", "instructions": ["புட்டை ஆவியில் வேக வைக்கவும்", "கடலைக்கறி தயார் செய்யவும்", "ஒன்றாகப் பரிமாறவும்"] },
                "rec-21": { "title": "மீன் குழம்பு", "instructions": ["புளித் தண்ணீரைத் தயார் செய்யவும்", "மசாலா வாசனை போகும் வரை கொதிக்க விட்டு மீனைச் சேர்க்கவும்", "சாதத்துடன் பரிமாறவும்"] },
                "rec-22": { "title": "ஆம்பூர் பிரியாணி", "instructions": ["இறைச்சியைச் சமைக்கவும்", "சீரக சம்பா அரிசியுடன் வேக வைக்கவும்", "தம் போட்டுப் பரிமாறவும்"] },
                "rec-23": { "title": "நாட்டுக்கோழி குழம்பு", "instructions": ["மசாலாக்களை வறுத்து அரைக்கவும்", "சிக்கனை குக்கரில் வேக வைக்கவும்", "சாதத்துடன் பரிமாறவும்"] },
                "rec-24": { "title": "பள்ளிபாளையம் சிக்கன்", "instructions": ["வரமிளகாய் சேர்த்து வதக்கவும்", "சிக்கனை மெதுவான தீயில் வேக வைக்கவும்", "தண்ணீர் வற்றும் வரை வதக்கவும்"] },
                "rec-25": { "title": "வத்த குழம்பு", "instructions": ["புளியைக் கரைக்கவும்", "சுண்டைக்காய் வத்தலை வறுக்கவும்", "எண்ணெய் பிரியும் வரை கொதிக்க விடவும்"] },
                "rec-26": { "title": "தயிர் சாதம்", "instructions": ["சாதத்தை நன்றாக மசிக்கவும்", "தயிர் மற்றும் பால் சேர்க்கவும்", "தாளித்துப் பரிமாறவும்"] },
                "rec-27": { "title": "இடியாப்பம் ஸ்டூ", "instructions": ["இடியாப்பத்தை ஆவியில் வேக வைக்கவும்", "தேங்காய்ப்பால் காய்கறி ஸ்டூ தயார் செய்யவும்", "ஒன்றாகப் பரிமாறவும்"] },
