            "ingredients_names": {
                "Tomato": "தக்காளி", "Onion": "வெங்காயம்", "Potato": "உருளைக்கிழங்கு", "Carrot": "கேரட்", "Spinach": "கீரை", "Bell Pepper": "குடைமிளகாய்", "Broccoli": "புரோக்கோலி", "Cauliflower": "காலிபிளவர்", "Lemon": "எலுமிச்சை", "Mango": "மாம்பழம்", "Turmeric": "மஞ்சள்", "Cumin": "சீரகம்", "Coriander": "கொத்தமல்லி", "Garam Masala": "கரம் மசாலா", "Red Chili": "சிவப்பு மிளகாய்", "Garlic": "பூண்டு", "Ginger": "இஞ்சி", "Milk": "பால்", "Yogurt": "தயிர்", "Paneer": "பன்னீர்", "Butter": "வெண்ணெய்", "Cheese": "சீஸ்", "Chicken": "கோழி", "Beef": "மாட்டிறைச்சி", "Fish": "மீன்", "Mutton": "ஆட்டிறைச்சி", "Rice": "அரிசி", "Wheat Flour": "கோதுமை மாவு", "Lentils": "பருப்பு", "Pasta": "பாஸ்தா", "Cucumber": "வெள்ளரிக்காய்", "Mushroom": "காளான்", "Orange": "ஆரஞ்சு", "Strawberry": "ஸ்ட்ராபெர்ரி", "Star Anise": "அன்னாசிப்பூ", "Cardamom": "ஏலக்காய்", "Egg": "முட்டை", "Lamb": "ஆட்டுக்குட்டி", "Oats": "ஓட்ஸ்", "Quinoa": "குயினோவா", "Curry Leaves": "கறிவேப்பிலை", "Mustard Seeds": "கடுகு", "Coconut": "தேங்காய்", "Tamarind": "புளி"
